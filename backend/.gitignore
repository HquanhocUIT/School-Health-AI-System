.pytest_cache/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
.coverage.*
htmlcov/

# Build and package output
dist/
build/
*.egg-info/
pip-wheel-metadata/

# Local logs, temporary files, and editor backups
*.log
*.tmp
*.bak
*~

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
